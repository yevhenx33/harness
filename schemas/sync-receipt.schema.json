{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "sync_state", "evidence", "risk", "next"],
  "properties": {
    "task_id": {"type": "string", "const": "harness-sync-assessment-v1"},
    "sync_state": {
      "type": "string",
      "enum": ["up-to-date", "fast-forward-available", "ahead", "dirty", "diverged", "inconclusive"]
    },
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "risk": {"type": "string"},
    "next": {"type": "string"}
  }
}
