{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "target",
    "local_commit",
    "remote_commit",
    "sync_state",
    "evidence",
    "risk",
    "next"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "const": "harness-sync-assessment-v2"
    },
    "sync_state": {
      "type": "string",
      "enum": [
        "up-to-date",
        "fast-forward-available",
        "ahead",
        "dirty",
        "diverged",
        "inconclusive"
      ]
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "risk": {
      "type": "string"
    },
    "next": {
      "type": "string"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "remote",
        "branch"
      ],
      "properties": {
        "root": {
          "type": "string"
        },
        "remote": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        }
      }
    },
    "local_commit": {
      "type": "string"
    },
    "remote_commit": {
      "type": "string"
    }
  }
}
